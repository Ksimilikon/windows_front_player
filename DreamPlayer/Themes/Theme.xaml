<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark theme: green accent, red for errors, yellow for warnings.
    The system accent is overridden, so every stock control (buttons, sliders,
    toggles, selection) picks up the green.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#22C55E</Color>
            <Color x:Key="SystemAccentColorLight1">#4ADE80</Color>
            <Color x:Key="SystemAccentColorLight2">#86EFAC</Color>
            <Color x:Key="SystemAccentColorLight3">#BBF7D0</Color>
            <Color x:Key="SystemAccentColorDark1">#16A34A</Color>
            <Color x:Key="SystemAccentColorDark2">#15803D</Color>
            <Color x:Key="SystemAccentColorDark3">#166534</Color>

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#121212" />

            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#3A1515" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#3A3112" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#12301D" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#EF4444" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#EAB308" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#22C55E" />

            <SolidColorBrush x:Key="TabViewBackground" Color="#121212" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#1A1A1A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- palette -->
    <Color x:Key="DpBgColor">#121212</Color>
    <Color x:Key="DpSurfaceColor">#1A1A1A</Color>
    <Color x:Key="DpAccentColor">#22C55E</Color>
    <Color x:Key="DpErrorColor">#EF4444</Color>
    <Color x:Key="DpWarningColor">#EAB308</Color>

    <SolidColorBrush x:Key="DpBg" Color="#121212" />
    <SolidColorBrush x:Key="DpSurface" Color="#1A1A1A" />
    <SolidColorBrush x:Key="DpSurface2" Color="#232323" />
    <SolidColorBrush x:Key="DpBorder" Color="#2E2E2E" />
    <SolidColorBrush x:Key="DpText" Color="#E8E8E8" />
    <SolidColorBrush x:Key="DpTextMuted" Color="#9A9A9A" />
    <SolidColorBrush x:Key="DpAccent" Color="#22C55E" />
    <SolidColorBrush x:Key="DpError" Color="#EF4444" />
    <SolidColorBrush x:Key="DpWarning" Color="#EAB308" />

    <FontFamily x:Key="DpIcons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="DpMono">Cascadia Mono,Consolas</FontFamily>

    <!-- borderless square icon button (player controls, toolbars) -->
    <Style x:Key="DpIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
    </Style>

    <Style x:Key="DpIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
    </Style>

    <Style x:Key="DpSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="DpPaneTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DpMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DpTextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- a pane: surface card with a border -->
    <Style x:Key="DpPane" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DpSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource DpBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
</ResourceDictionary>
