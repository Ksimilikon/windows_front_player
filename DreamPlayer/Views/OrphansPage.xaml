<?xml version="1.0" encoding="utf-8"?>
<!-- ORPHANS: the library's garbage collector — songs that are in no playlist,
     with their file paths. Filter: not marked / kept / all. -->
<UserControl
    x:Class="DreamPlayer.Views.OrphansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer"
    xmlns:views="using:DreamPlayer.Views"
    xmlns:core="using:DreamPlayer.Core">

    <Border Margin="12" Style="{StaticResource DpPane}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind local:L.T('orphans.title')}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="Summary" Style="{StaticResource DpMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="KeepButton" Click="Keep_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="KeepGlyph" Glyph="&#xE718;" FontSize="14" />
                            <TextBlock x:Name="KeepText" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource DpError}" />
                            <TextBlock Text="{x:Bind local:L.T('orphans.delete_selected')}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteAllButton" Click="DeleteAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE894;" FontSize="14" Foreground="{StaticResource DpError}" />
                            <TextBlock Text="{x:Bind local:L.T('orphans.delete_all')}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DpIconButton}" Click="Reload_Click" ToolTipService.ToolTip="{x:Bind local:L.T('common.reload')}" AutomationProperties.Name="{x:Bind local:L.T('common.reload')}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="{x:Bind local:L.T('orphans.hint')}" Style="{StaticResource DpMuted}" TextWrapping="Wrap" TextTrimming="None" FontSize="13" />

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButtons x:Name="FilterBox" MaxColumns="3" SelectionChanged="Filter_Changed" />
                <TextBox x:Name="Search" Grid.Column="1" VerticalAlignment="Center" PlaceholderText="{x:Bind local:L.T('common.search_tracks')}" TextChanged="Search_TextChanged" />
            </Grid>

            <ListView
                x:Name="TrackList"
                Grid.Row="3"
                SelectionMode="Extended"
                SelectionChanged="TrackList_SelectionChanged"
                DoubleTapped="TrackList_DoubleTapped"
                KeyDown="TrackList_KeyDown"
                ContextRequested="TrackList_ContextRequested">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:Track">
                        <Grid Padding="0,5" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="2" Background="{x:Bind views:Ui.ColorBrush(Color)}" />
                            <Grid Grid.Column="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <views:CoverThumb Width="36" Height="36" Track="{x:Bind}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Foreground="{x:Bind views:Ui.TitleBrush(Invalid)}" />
                                    <TextBlock Text="{x:Bind ArtistsLine}" Style="{StaticResource DpMuted}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind views:Ui.Dash(Path)}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                FontFamily="{StaticResource DpMono}"
                                Style="{StaticResource DpMuted}"
                                ToolTipService.ToolTip="{x:Bind Path}" />
                            <Border
                                Grid.Column="3"
                                Padding="6,1"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{StaticResource DpSurface2}"
                                Visibility="{x:Bind IgnoreOrphan}">
                                <TextBlock Text="{x:Bind local:L.T('orphans.kept_badge')}" FontSize="11" Foreground="{StaticResource DpAccent}" />
                            </Border>
                            <TextBlock Grid.Column="4" Text="{x:Bind DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource DpMuted}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource DpMuted}"
                FontSize="14" />
        </Grid>
    </Border>
</UserControl>
