<?xml version="1.0" encoding="utf-8"?>
<!-- IMPORT: a packet file into the library (two-step core import). -->
<UserControl
    x:Class="DreamPlayer.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer"
    xmlns:views="using:DreamPlayer.Views"
    xmlns:svc="using:DreamPlayer.Services">

    <Grid Padding="24" RowSpacing="16" ColumnSpacing="24" MaxWidth="1400" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="14">
            <TextBlock Text="{x:Bind local:L.T('import.title')}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind local:L.T('import.hint')}" Style="{StaticResource DpMuted}" TextWrapping="Wrap" FontSize="13" />

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PacketBox" Header="{x:Bind local:L.T('import.packet')}" TextChanged="Inputs_Changed" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowsePacket_Click" ToolTipService.ToolTip="{x:Bind local:L.T('common.browse')}" AutomationProperties.Name="{x:Bind local:L.T('common.browse')}">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
            </Grid>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveToBox" Header="{x:Bind local:L.T('import.save_to')}" TextChanged="Inputs_Changed" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseSaveTo_Click" ToolTipService.ToolTip="{x:Bind local:L.T('common.browse')}" AutomationProperties.Name="{x:Bind local:L.T('common.browse')}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </Button>
            </Grid>

            <ToggleSwitch x:Name="ForceSwitch" Header="{x:Bind local:L.T('import.force')}" />
            <TextBlock Text="{x:Bind local:L.T('import.force_hint')}" Style="{StaticResource DpMuted}" TextWrapping="Wrap" Margin="0,-10,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Click="Run_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="{x:Bind local:L.T('import.run')}" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="Progress" IsActive="False" Width="20" Height="20" />
            </StackPanel>
        </StackPanel>

        <!-- the same import straight from another device that sends from its export tab -->
        <Border Grid.Column="1" Style="{StaticResource DpPane}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind local:L.T('import.receive_title')}" Style="{StaticResource DpPaneTitle}" />
                <TextBlock Text="{x:Bind local:L.T('import.receive_hint')}" Style="{StaticResource DpMuted}" TextWrapping="Wrap" TextTrimming="None" />
                <views:ConnectionPicker x:Name="Connection" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ReceiveButton" Click="Receive_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="{x:Bind local:L.T('import.receive')}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelReceiveButton" Content="{x:Bind local:L.T('common.cancel')}" IsEnabled="False" Click="CancelReceive_Click" />
                    <ProgressRing x:Name="ReceiveProgress" IsActive="False" Width="20" Height="20" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DpPane}">
            <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" Style="{StaticResource DpIconButton}" Click="SaveLog_Click" ToolTipService.ToolTip="{x:Bind local:L.T('log.save')}" AutomationProperties.Name="{x:Bind local:L.T('log.save')}">
                <FontIcon Glyph="&#xE74E;" FontSize="14" />
            </Button>
            <ListView x:Name="Messages" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:LogEntry">
                        <TextBlock
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Foreground="{x:Bind views:Ui.LevelBrush(Level)}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
