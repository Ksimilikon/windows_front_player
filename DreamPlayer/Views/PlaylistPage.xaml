<?xml version="1.0" encoding="utf-8"?>
<!-- A playlist tab: one playlist, not playing. Starting it turns the tab into
     the playing one (NOW PLAYING, "name *"). -->
<UserControl
    x:Class="DreamPlayer.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DreamPlayer.Views">

    <views:PlaylistTracksView x:Name="Tracks" Margin="12" InTab="True" />
</UserControl>
