<?xml version="1.0" encoding="utf-8"?>
<!-- PLAYLISTS: every playlist on the left (the "all songs" pool first), the
     tracks of the selected one on the right. -->
<UserControl
    x:Class="DreamPlayer.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer"
    xmlns:views="using:DreamPlayer.Views">

    <Grid Padding="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- playlists -->
        <Border Style="{StaticResource DpPane}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{x:Bind local:L.T('playlists.title')}" Style="{StaticResource DpPaneTitle}" />
                    <Button
                        HorizontalAlignment="Right"
                        Style="{StaticResource DpIconButton}"
                        Click="New_Click"
                        ToolTipService.ToolTip="{x:Bind local:L.T('playlists.new')}" AutomationProperties.Name="{x:Bind local:L.T('playlists.new')}">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </Grid>
                <TextBox
                    x:Name="PlaylistSearch"
                    Grid.Row="1"
                    PlaceholderText="{x:Bind local:L.T('common.search')}"
                    TextChanged="PlaylistSearch_TextChanged" />
                <ListView
                    x:Name="PlaylistList"
                    Grid.Row="2"
                    SelectionMode="Single"
                    SelectionChanged="PlaylistList_SelectionChanged"
                    DoubleTapped="PlaylistList_DoubleTapped"
                    ContextRequested="PlaylistList_ContextRequested">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:PlaylistRow">
                            <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <views:CoverThumb Width="44" Height="44" Playlist="{x:Bind View}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind View.DisplayName}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{x:Bind views:Ui.PlayingBrush(IsPlaying), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind View.CountText}" Style="{StaticResource DpMuted}" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="2"
                                    Glyph="&#xE768;"
                                    FontSize="12"
                                    Foreground="{StaticResource DpAccent}"
                                    Visibility="{x:Bind IsPlaying, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- tracks of the selected playlist -->
        <views:PlaylistTracksView x:Name="Tracks" Grid.Column="1" />
    </Grid>
</UserControl>
