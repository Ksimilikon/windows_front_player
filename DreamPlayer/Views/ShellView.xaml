<?xml version="1.0" encoding="utf-8"?>
<!--
    The app skeleton: tabs on top (with the menu button in the tab strip), the
    message bars, the now-playing bar and the master volume across the whole
    bottom edge.
-->
<UserControl
    x:Class="DreamPlayer.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer">

    <Grid Background="{StaticResource DpBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="Tabs"
            IsAddTabButtonVisible="False"
            CanReorderTabs="False"
            CanDragTabs="False"
            TabWidthMode="SizeToContent"
            TabCloseRequested="Tabs_TabCloseRequested"
            SelectionChanged="Tabs_SelectionChanged">
            <TabView.TabStripHeader>
                <Button
                    x:Name="MenuButton"
                    Margin="6,6,6,0"
                    Style="{StaticResource DpIconButton}"
                    ToolTipService.ToolTip="{x:Bind local:L.T('menu.tooltip')}" AutomationProperties.Name="{x:Bind local:L.T('menu.tooltip')}">
                    <FontIcon FontFamily="{StaticResource DpIcons}" Glyph="&#xE700;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.import')}" Click="Menu_Import">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.export')}" Click="Menu_Export">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.sync')}" Click="Menu_Sync">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.new_playlist')}" Click="Menu_NewPlaylist">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.add_files')}" Click="Menu_AddFiles">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.scan_folder')}" Click="Menu_ScanFolder">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.rescan')}" Click="Menu_Rescan">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.remove_invalid')}" Click="Menu_RemoveInvalid">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.orphans')}" Click="Menu_Orphans">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.settings')}" Click="Menu_Settings">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.log')}" Click="Menu_Log">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind local:L.T('menu.exit')}" Click="Menu_Exit">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TabView.TabStripHeader>
        </TabView>

        <!-- messages: errors red, warnings yellow, success green -->
        <StackPanel Grid.Row="1" Margin="8,0,8,4" Spacing="4">
            <InfoBar x:Name="BusyBar" IsOpen="False" IsClosable="False" Severity="Informational">
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,8" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar x:Name="Toast" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <!-- now playing -->
        <Grid
            Grid.Row="2"
            Padding="10,8"
            ColumnSpacing="12"
            Background="{StaticResource DpSurface}"
            BorderBrush="{StaticResource DpBorder}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- the track: a click opens the song tab -->
            <Button
                x:Name="NowButton"
                Padding="4"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Left"
                Click="NowButton_Click"
                ToolTipService.ToolTip="{x:Bind local:L.T('bar.open_song')}" AutomationProperties.Name="{x:Bind local:L.T('bar.open_song')}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="4" Background="{StaticResource DpSurface2}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource DpTextMuted}" />
                            <Image x:Name="BarCover" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="160">
                        <TextBlock x:Name="BarTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BarArtists" Style="{StaticResource DpMuted}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- progress (drag to seek) -->
            <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PosText" Text="0:00" VerticalAlignment="Center" Style="{StaticResource DpMuted}" />
                <Slider
                    x:Name="SeekSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="1"
                    IsThumbToolTipEnabled="False"
                    VerticalAlignment="Center"
                    ValueChanged="SeekSlider_ValueChanged" />
                <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" Style="{StaticResource DpMuted}" />
            </Grid>

            <!-- controls: grouped on the right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton
                    x:Name="ShuffleButton"
                    Style="{StaticResource DpIconToggle}"
                    Click="Shuffle_Click"
                    ToolTipService.ToolTip="{x:Bind local:L.T('bar.shuffle')}" AutomationProperties.Name="{x:Bind local:L.T('bar.shuffle')}">
                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="PrevButton" Style="{StaticResource DpIconButton}" Click="Prev_Click" ToolTipService.ToolTip="{x:Bind local:L.T('bar.prev')}" AutomationProperties.Name="{x:Bind local:L.T('bar.prev')}">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button x:Name="BackButton" Style="{StaticResource DpIconButton}" Click="Back_Click" ToolTipService.ToolTip="{x:Bind local:L.T('bar.rewind')}" AutomationProperties.Name="{x:Bind local:L.T('bar.rewind')}">
                    <FontIcon Glyph="&#xEB9E;" FontSize="16" />
                </Button>
                <Button
                    x:Name="PlayButton"
                    Width="46"
                    Height="46"
                    CornerRadius="23"
                    Padding="0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Play_Click"
                    ToolTipService.ToolTip="{x:Bind local:L.T('bar.play_pause')}" AutomationProperties.Name="{x:Bind local:L.T('bar.play_pause')}">
                    <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="18" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource DpIconButton}" Click="Forward_Click" ToolTipService.ToolTip="{x:Bind local:L.T('bar.forward')}" AutomationProperties.Name="{x:Bind local:L.T('bar.forward')}">
                    <FontIcon Glyph="&#xEB9D;" FontSize="16" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource DpIconButton}" Click="Next_Click" ToolTipService.ToolTip="{x:Bind local:L.T('bar.next')}" AutomationProperties.Name="{x:Bind local:L.T('bar.next')}">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource DpIconButton}" Click="Stop_Click" ToolTipService.ToolTip="{x:Bind local:L.T('bar.stop')}" AutomationProperties.Name="{x:Bind local:L.T('bar.stop')}">
                    <FontIcon Glyph="&#xE71A;" FontSize="16" />
                </Button>
                <Button x:Name="RepeatButton" Style="{StaticResource DpIconButton}" Click="Repeat_Click">
                    <FontIcon x:Name="RepeatGlyph" Glyph="&#xE8EE;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- master volume: the whole width at the very bottom -->
        <Grid
            Grid.Row="3"
            Padding="14,0,14,4"
            ColumnSpacing="12"
            Background="{StaticResource DpSurface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="VolumeGlyph"
                Glyph="&#xE767;"
                FontSize="16"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind local:L.T('bar.master_volume')}" AutomationProperties.Name="{x:Bind local:L.T('bar.master_volume')}" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                VerticalAlignment="Center"
                ValueChanged="VolumeSlider_ValueChanged"
                PointerWheelChanged="VolumeSlider_PointerWheelChanged" />
            <TextBlock
                x:Name="VolumeText"
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Style="{StaticResource DpMuted}" />
        </Grid>
    </Grid>
</UserControl>
