<?xml version="1.0" encoding="utf-8"?>
<!-- SONG: the cover with the per-track volume slider on its left, and every
     piece of metadata. Closes by itself when another tab is selected. -->
<UserControl
    x:Class="DreamPlayer.Views.SongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- per-track volume (0..200%) -->
            <StackPanel VerticalAlignment="Top" Spacing="6" Width="64">
                <FontIcon Glyph="&#xE767;" FontSize="16" HorizontalAlignment="Center" ToolTipService.ToolTip="{x:Bind local:L.T('song.volume')}" />
                <TextBlock x:Name="VolumeText" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <Slider
                    x:Name="VolumeSlider"
                    Orientation="Vertical"
                    Height="300"
                    HorizontalAlignment="Center"
                    Minimum="0"
                    Maximum="200"
                    StepFrequency="1"
                    TickFrequency="100"
                    TickPlacement="Outside"
                    ValueChanged="VolumeSlider_ValueChanged"
                    PointerWheelChanged="VolumeSlider_PointerWheelChanged" />
                <Button HorizontalAlignment="Center" Padding="8,2" Content="100%" Click="ResetVolume_Click" ToolTipService.ToolTip="{x:Bind local:L.T('song.volume_reset')}" />
            </StackPanel>

            <!-- cover -->
            <Border
                Grid.Column="1"
                Width="340"
                Height="340"
                VerticalAlignment="Top"
                CornerRadius="10"
                Background="{StaticResource DpSurface2}"
                BorderBrush="{StaticResource DpBorder}"
                BorderThickness="1">
                <Grid>
                    <FontIcon x:Name="NoCover" Glyph="&#xE8D6;" FontSize="72" Foreground="{StaticResource DpTextMuted}" />
                    <Image x:Name="Cover" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <!-- metadata -->
            <StackPanel Grid.Column="2" Spacing="4" MinWidth="280">
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="ArtistsText" FontSize="18" Foreground="{StaticResource DpTextMuted}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Border x:Name="InvalidBar" Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="#3A1515" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{StaticResource DpError}" />
                        <TextBlock Text="{x:Bind local:L.T('song.invalid')}" Foreground="{StaticResource DpError}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,8">
                    <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Click="Play_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="{x:Bind local:L.T('track.play')}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditButton" Click="Edit_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="{x:Bind local:L.T('track.edit_meta')}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FolderButton" Click="Folder_Click" ToolTipService.ToolTip="{x:Bind local:L.T('track.show_in_folder')}">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                </StackPanel>
                <!-- key / value rows, filled in code -->
                <Grid x:Name="MetaGrid" ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
