<?xml version="1.0" encoding="utf-8"?>
<!-- LOG: how the frontend talks to the core (FFI calls, statuses, callbacks,
     panics). Errors red, warnings yellow, successful calls green. -->
<UserControl
    x:Class="DreamPlayer.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer"
    xmlns:views="using:DreamPlayer.Views"
    xmlns:svc="using:DreamPlayer.Services">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="LevelBox" MinWidth="200" SelectionChanged="LevelBox_SelectionChanged" />
            <TextBox x:Name="Search" Grid.Column="1" PlaceholderText="{x:Bind local:L.T('log.search')}" TextChanged="Search_TextChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="FollowToggle" IsChecked="True" Style="{StaticResource DpIconToggle}" ToolTipService.ToolTip="{x:Bind local:L.T('log.follow')}" AutomationProperties.Name="{x:Bind local:L.T('log.follow')}">
                    <FontIcon Glyph="&#xE74B;" FontSize="14" />
                </ToggleButton>
                <Button Style="{StaticResource DpIconButton}" Click="Copy_Click" ToolTipService.ToolTip="{x:Bind local:L.T('log.copy')}" AutomationProperties.Name="{x:Bind local:L.T('log.copy')}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource DpIconButton}" Click="OpenFile_Click" ToolTipService.ToolTip="{x:Bind local:L.T('log.open_file')}" AutomationProperties.Name="{x:Bind local:L.T('log.open_file')}">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource DpIconButton}" Click="Clear_Click" ToolTipService.ToolTip="{x:Bind local:L.T('log.clear')}" AutomationProperties.Name="{x:Bind local:L.T('log.clear')}">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- core panics (from the core's own panic log) -->
        <InfoBar x:Name="PanicBar" Grid.Row="1" IsClosable="False" Severity="Error">
            <InfoBar.ActionButton>
                <Button Content="{x:Bind local:L.T('log.show_panics')}" Click="ShowPanics_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border Grid.Row="2" Style="{StaticResource DpPane}" Padding="4">
            <ListView x:Name="Entries" SelectionMode="Extended">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Padding" Value="8,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:LogEntry">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TimeText}" FontFamily="{StaticResource DpMono}" FontSize="12" Foreground="{StaticResource DpTextMuted}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind LevelText}" FontFamily="{StaticResource DpMono}" FontSize="12" Foreground="{x:Bind views:Ui.LevelBrush(Level)}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Area}" FontFamily="{StaticResource DpMono}" FontSize="12" Foreground="{StaticResource DpTextMuted}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Text}" FontFamily="{StaticResource DpMono}" FontSize="12" TextWrapping="Wrap" Foreground="{x:Bind views:Ui.LevelBrush(Level)}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
