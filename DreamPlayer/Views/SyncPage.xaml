<?xml version="1.0" encoding="utf-8"?>
<!-- DEVICES: two-way library sync with another device (Wi-Fi, USB, Bluetooth)
     and the list of paired devices; the session log on the right. -->
<UserControl
    x:Class="DreamPlayer.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer"
    xmlns:views="using:DreamPlayer.Views"
    xmlns:core="using:DreamPlayer.Core"
    xmlns:svc="using:DreamPlayer.Services">

    <Grid Padding="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- sync -->
            <Border Style="{StaticResource DpPane}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBlock Text="{x:Bind local:L.T('sync.title')}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind local:L.T('sync.hint')}" Style="{StaticResource DpMuted}" TextWrapping="Wrap" TextTrimming="None" FontSize="13" />
                        <StackPanel>
                            <TextBlock Text="{x:Bind local:L.T('sync.own_key')}" Style="{StaticResource DpMuted}" />
                            <TextBlock x:Name="OwnKey" FontFamily="{StaticResource DpMono}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <views:ConnectionPicker x:Name="Connection" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="{x:Bind local:L.T('sync.start')}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" Content="{x:Bind local:L.T('common.cancel')}" Click="Cancel_Click" IsEnabled="False" />
                            <ProgressRing x:Name="Progress" IsActive="False" Width="20" Height="20" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- paired devices -->
            <Border Grid.Row="1" Style="{StaticResource DpPane}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{x:Bind local:L.T('sync.paired_title')}" Style="{StaticResource DpPaneTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                            <Button x:Name="RenameButton" Style="{StaticResource DpIconButton}" Click="Rename_Click" ToolTipService.ToolTip="{x:Bind local:L.T('sync.rename')}" AutomationProperties.Name="{x:Bind local:L.T('sync.rename')}">
                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                            </Button>
                            <Button x:Name="ForgetButton" Style="{StaticResource DpIconButton}" Click="Forget_Click" ToolTipService.ToolTip="{x:Bind local:L.T('sync.forget')}" AutomationProperties.Name="{x:Bind local:L.T('sync.forget')}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource DpError}" />
                            </Button>
                            <Button Style="{StaticResource DpIconButton}" Click="Reload_Click" ToolTipService.ToolTip="{x:Bind local:L.T('common.reload')}" AutomationProperties.Name="{x:Bind local:L.T('common.reload')}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView
                        x:Name="PairedList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="PairedList_SelectionChanged"
                        ContextRequested="PairedList_ContextRequested">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:PairedDevice">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Fingerprint}" FontFamily="{StaticResource DpMono}" Style="{StaticResource DpMuted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind IdText}" VerticalAlignment="Center" Style="{StaticResource DpMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="PairedEmpty"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Style="{StaticResource DpMuted}" />
                </Grid>
            </Border>
        </Grid>

        <!-- session log -->
        <Border Grid.Column="1" Style="{StaticResource DpPane}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{x:Bind local:L.T('sync.log_title')}" Style="{StaticResource DpPaneTitle}" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource DpIconButton}" Click="SaveLog_Click" ToolTipService.ToolTip="{x:Bind local:L.T('log.save')}" AutomationProperties.Name="{x:Bind local:L.T('log.save')}">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>
                </Grid>
                <ListView x:Name="Messages" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogEntry">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TimeText}" FontFamily="{StaticResource DpMono}" Style="{StaticResource DpMuted}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Text}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Foreground="{x:Bind views:Ui.LevelBrush(Level)}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
