<?xml version="1.0" encoding="utf-8"?>
<!-- SETTINGS: interface, audio, library, log, about. -->
<UserControl
    x:Class="DreamPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamPlayer">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind local:L.T('tab.settings')}" FontSize="22" FontWeight="SemiBold" />

            <!-- interface -->
            <TextBlock Text="{x:Bind local:L.T('settings.interface')}" Style="{StaticResource DpSectionTitle}" />
            <Border Style="{StaticResource DpPane}">
                <ComboBox x:Name="LanguageBox" Header="{x:Bind local:L.T('settings.language')}" MinWidth="240" SelectionChanged="LanguageBox_SelectionChanged" />
            </Border>

            <!-- audio -->
            <TextBlock Text="{x:Bind local:L.T('settings.audio')}" Style="{StaticResource DpSectionTitle}" />
            <Border Style="{StaticResource DpPane}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="DeviceBox" Header="{x:Bind local:L.T('settings.device')}" MinWidth="360" SelectionChanged="DeviceBox_SelectionChanged" />
                        <Button VerticalAlignment="Bottom" Click="RefreshDevices_Click" ToolTipService.ToolTip="{x:Bind local:L.T('settings.device_refresh')}" AutomationProperties.Name="{x:Bind local:L.T('settings.device_refresh')}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SpeedText" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider x:Name="SpeedSlider" Width="320" Minimum="0.5" Maximum="2" StepFrequency="0.05" ValueChanged="SpeedSlider_ValueChanged" />
                            <Button Content="1.0×" Click="ResetSpeed_Click" />
                        </StackPanel>
                    </StackPanel>
                    <NumberBox
                        x:Name="SeekStepBox"
                        Header="{x:Bind local:L.T('settings.seek_step')}"
                        Width="200"
                        HorizontalAlignment="Left"
                        Minimum="1"
                        Maximum="120"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="SeekStepBox_ValueChanged" />
                </StackPanel>
            </Border>

            <!-- library -->
            <TextBlock Text="{x:Bind local:L.T('settings.library')}" Style="{StaticResource DpSectionTitle}" />
            <Border Style="{StaticResource DpPane}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MusicDirBox" Header="{x:Bind local:L.T('settings.music_dir')}" LostFocus="MusicDirBox_LostFocus" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseMusicDir_Click" ToolTipService.ToolTip="{x:Bind local:L.T('common.browse')}" AutomationProperties.Name="{x:Bind local:L.T('common.browse')}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="LibraryInfo" Style="{StaticResource DpMuted}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind local:L.T('menu.rescan')}" Click="Rescan_Click" />
                        <Button Content="{x:Bind local:L.T('menu.scan_folder')}" Click="ScanFolder_Click" />
                        <Button Content="{x:Bind local:L.T('menu.add_files')}" Click="AddFiles_Click" />
                    </StackPanel>
                    <Button Click="RemoveInvalid_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource DpError}" />
                            <TextBlock Text="{x:Bind local:L.T('menu.remove_invalid')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- log -->
            <TextBlock Text="{x:Bind local:L.T('settings.log')}" Style="{StaticResource DpSectionTitle}" />
            <Border Style="{StaticResource DpPane}">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="VerboseSwitch" Header="{x:Bind local:L.T('settings.verbose')}" Toggled="VerboseSwitch_Toggled" />
                    <TextBlock Text="{x:Bind local:L.T('settings.verbose_hint')}" Style="{StaticResource DpMuted}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind local:L.T('menu.log')}" Click="OpenLog_Click" />
                        <Button Content="{x:Bind local:L.T('settings.open_log_dir')}" Click="OpenLogDir_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- about -->
            <TextBlock Text="{x:Bind local:L.T('settings.about')}" Style="{StaticResource DpSectionTitle}" />
            <Border Style="{StaticResource DpPane}">
                <Grid x:Name="AboutGrid" ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
